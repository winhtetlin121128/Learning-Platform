# Pooled Neon URL for app/runtime queries
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
# Direct Neon URL for Drizzle schema pushes/migrations (optional if not provided)
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require
# Neon Managed Auth base URL for this branch
NEON_AUTH_BASE_URL=https://your-neon-auth-url
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters
# Optional demo seed accounts (development only)
DEMO_STUDENT_PASSWORD=StudentDemo2026!
DEMO_ADMIN_PASSWORD=AdminDemo2026!
DEMO_ADMIN_BOOTSTRAP_CODE=change-this-before-seeding
